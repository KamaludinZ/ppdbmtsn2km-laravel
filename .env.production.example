# ==================================================
# PPDB MTsN 2 Kota Malang - Production Environment
# ==================================================
# Optimized for shared hosting deployment
# Last updated: 2026-01-16
#
# IMPORTANT:
# - Copy this file to .env and fill in your actual values
# - Never commit .env file to version control!
# - Generate APP_KEY with: php artisan key:generate
# ==================================================

# --------------------------------------------------
# Application Configuration
# --------------------------------------------------
APP_NAME="PPDB MTsN 2 Kota Malang"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ppdb.mtsn2km.sch.id

# Timezone & Locale (Indonesia)
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --------------------------------------------------
# Logging Configuration
# --------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# --------------------------------------------------
# Database Configuration (PostgreSQL)
# --------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=ppdb_mtsn2km_production
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_SSLMODE=prefer

# --------------------------------------------------
# Session Configuration (Optimized for Shared Hosting)
# --------------------------------------------------
# Using file driver for better performance on shared hosting
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --------------------------------------------------
# Cache Configuration (Optimized for Shared Hosting)
# --------------------------------------------------
# Using file driver (no Redis needed on shared hosting)
CACHE_STORE=file
CACHE_PREFIX=ppdb_

# --------------------------------------------------
# Queue Configuration
# --------------------------------------------------
# Using database queue (run with cron job)
QUEUE_CONNECTION=database

# --------------------------------------------------
# Filesystem Configuration
# --------------------------------------------------
# Private storage by default for security
FILESYSTEM_DISK=local

# --------------------------------------------------
# Broadcasting
# --------------------------------------------------
BROADCAST_CONNECTION=log

# --------------------------------------------------
# Mail Configuration
# --------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@mtsn2km.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------
# Third Party Services (Optional)
# --------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------
# Asset Compilation
# --------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ==================================================
# DEPLOYMENT NOTES FOR SHARED HOSTING
# ==================================================
#
# 1. Required Cron Job (run every minute):
#    * * * * * cd /path/to/your/app && php artisan schedule:run >> /dev/null 2>&1
#
# 2. Queue Worker (optional, run every 5 minutes):
#    */5 * * * * cd /path/to/your/app && php artisan queue:work --stop-when-empty --max-time=300
#
# 3. After deployment commands:
#    php artisan key:generate
#    php artisan config:cache
#    php artisan route:cache
#    php artisan view:cache
#    php artisan migrate --force
#
# 4. File Permissions:
#    chmod 755 storage/ bootstrap/cache/ -R
#    chmod 644 .env
#
# 5. Clear cache commands (if needed):
#    php artisan cache:clear
#    php artisan config:clear
#    php artisan route:clear
#    php artisan view:clear
#    php artisan dashboard:clear-cache
#
# 6. Security Checklist:
#    ✓ APP_DEBUG=false
#    ✓ APP_ENV=production
#    ✓ Strong APP_KEY generated
#    ✓ Strong database password
#    ✓ HTTPS enabled (SESSION_SECURE_COOKIE=true)
#    ✓ Proper file permissions
#    ✓ .env outside public directory
#    ✓ Regular backups
#
# ==================================================
