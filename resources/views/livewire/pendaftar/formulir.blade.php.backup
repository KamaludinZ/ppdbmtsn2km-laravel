                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-semibold text-gray-900">Data Alamat & Kontak</h3>
                        @if($editModeAlamat)
                            <div class="space-x-2">
                                <button wire:click="saveDataAlamat" class="px-4 py-2 bg-emerald-600 text-white rounded-md hover:bg-emerald-700 text-sm">Simpan</button>
