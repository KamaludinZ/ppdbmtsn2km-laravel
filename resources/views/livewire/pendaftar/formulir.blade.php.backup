                            <button wire:click="toggleEdit('alamat')" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 text-sm">Edit Data</button>
                        @endif
                    </div>
                    @if($editModeAlamat)
                        <form wire:submit.prevent="saveDataAlamat" class="grid grid-cols-1 md:grid-cols-2 gap-4"
                              x-data="{
                                  provinces: [],
                                  regencies: [],
                                  districts: [],
                                  villages: [],
                                  selectedProv: @entangle('provinsi'),
                                  selectedKab: @entangle('kabupaten'),
                                  selectedKec: @entangle('kecamatan'),
                                  selectedKel: @entangle('desa'),
                                  async init() {
                                      await this.fetchProvinces();
                                      if(this.selectedProv) await this.loadRegencies(this.selectedProv);
                                      if(this.selectedKab) await this.loadDistricts(this.selectedKab);
                                      if(this.selectedKec) await this.loadVillages(this.selectedKec);
                                  },
                                  async fetchProvinces() {
                                      try {
                                          let res = await fetch('https://www.emsifa.com/api-wilayah-indonesia/api/provinces.json');
                                          this.provinces = await res.json();
                                      } catch(e) { console.error(e); }
                                  },
                                  async loadRegencies(provName) {
                                      let prov = this.provinces.find(p => p.name == provName);
                                      if(!prov) return;
                                      try {
                                          let res = await fetch(`https://www.emsifa.com/api-wilayah-indonesia/api/regencies/${prov.id}.json`);
                                          this.regencies = await res.json();
                                      } catch(e) { console.error(e); }
                                  },
                                  async loadDistricts(kabName) {
                                      let kab = this.regencies.find(k => k.name == kabName);
                                      if(!kab) return;
                                      try {
                                          let res = await fetch(`https://www.emsifa.com/api-wilayah-indonesia/api/districts/${kab.id}.json`);
                                          this.districts = await res.json();
                                      } catch(e) { console.error(e); }
                                  },
                                  async loadVillages(kecName) {
                                      let kec = this.districts.find(k => k.name == kecName);
                                      if(!kec) return;
                                      try {
                                          let res = await fetch(`https://www.emsifa.com/api-wilayah-indonesia/api/villages/${kec.id}.json`);
                                          this.villages = await res.json();
                                      } catch(e) { console.error(e); }
                                  },
                                  async changeProv() {
                                      this.selectedKab = ''; this.selectedKec = ''; this.selectedKel = '';
                                      this.regencies = []; this.districts = []; this.villages = [];
                                      await this.loadRegencies(this.selectedProv);
                                  },
                                  async changeKab() {
                                      this.selectedKec = ''; this.selectedKel = '';
                                      this.districts = []; this.villages = [];
                                      await this.loadDistricts(this.selectedKab);
                                  },
                                  async changeKec() {
                                      this.selectedKel = '';
                                      this.villages = [];
                                      await this.loadVillages(this.selectedKec);
                                  }
                              }">
                            
                            <div class="md:col-span-2"><h4 class="font-bold text-gray-700 border-b pb-2 mb-2">Alamat Siswa</h4></div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Negara</label>
                                <input type="text" value="Indonesia" readonly class="w-full rounded-md border-gray-300 bg-gray-100 text-gray-500 mt-1">
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Provinsi</label>
                                <select x-model="selectedProv" @change="changeProv" class="w-full rounded-md border-gray-300 mt-1">
                                    <option value="">Pilih Provinsi</option>
                                    <template x-for="p in provinces" :key="p.id">
                                        <option :value="p.name" x-text="p.name"></option>
                                    </template>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Kabupaten/Kota</label>
                                <select x-model="selectedKab" @change="changeKab" class="w-full rounded-md border-gray-300 mt-1" :disabled="!regencies.length">
                                    <option value="">Pilih Kabupaten/Kota</option>
                                    <template x-for="r in regencies" :key="r.id">
                                        <option :value="r.name" x-text="r.name"></option>
                                    </template>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Kecamatan</label>
                                <select x-model="selectedKec" @change="changeKec" class="w-full rounded-md border-gray-300 mt-1" :disabled="!districts.length">
                                    <option value="">Pilih Kecamatan</option>
                                    <template x-for="d in districts" :key="d.id">
                                        <option :value="d.name" x-text="d.name"></option>
                                    </template>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Desa/Kelurahan</label>
                                <select x-model="selectedKel" class="w-full rounded-md border-gray-300 mt-1" :disabled="!villages.length">
                                    <option value="">Pilih Desa/Kelurahan</option>
                                    <template x-for="v in villages" :key="v.id">
                                        <option :value="v.name" x-text="v.name"></option>
                                    </template>
                                </select>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Kode Pos</label>
                                <input type="text" wire:model="kode_pos" class="w-full rounded-md border-gray-300 mt-1">
                            </div>
                            
                            <div class="md:col-span-2">
