{{-- Fallback untuk CDN failure --}}
@if(config('assets.enable_fallback') && ($assetMode === 'cdn' || $assetMode === 'mixed'))
<script>
    // Tailwind CSS fallback
    (function() {
        var link = document.querySelector('link[href*="tailwindcss"]');
        if (link) {
            link.onerror = function() {
                var fallback = document.createElement('link');
                fallback.rel = 'stylesheet';
                fallback.href = '{{ asset('css/tailwind.min.css') }}';
                document.head.appendChild(fallback);
            };
        }
    })();

    // Alpine.js fallback
    window.addEventListener('DOMContentLoaded', function() {
        if (typeof Alpine === 'undefined') {
            var script = document.createElement('script');
            script.src = '{{ asset('js/alpine.min.js') }}';
            script.defer = true;
            document.head.appendChild(script);
        }
    });
</script>
