<?php

namespace Tests\Unit;

use Tests\TestCase;
use Illuminate\Foundation\Testing\RefreshDatabase;
use App\Models\User;
use App\Models\Pendaftar;
use App\Models\AsalSekolah;
use App\Models\Faq;
use App\Models\Setting;
use Illuminate\Support\Facades\Validator;

class QualityTest extends TestCase
{
    use RefreshDatabase;

    public function test_model_validation_rules()
    {
        // Test User model validation
        $validator = Validator::make([
            'email' => 'invalid-email',
            'password' => 'short'
        ], [
            'email' => 'required|email',
            'password' => 'required|min:6'
        ]);

        $this->assertTrue($validator->fails());
        $this->assertArrayHasKey('email', $validator->errors()->messages());
        $this->assertArrayHasKey('password', $validator->errors()->messages());
    }

    public function test_data_integrity_constraints()
    {
        // Test unique constraint
        $user = User::factory()->create(['email' => 'test@example.com']);
        
        // Try to create another user with same email
        $duplicateUser = User::factory()->make(['email' => 'test@example.com']);
        
        $this->expectException(\Illuminate\Database\QueryException::class);
        $duplicateUser->save();
    }

    public function test_nullable_field_handling()
    {
        // Test that nullable fields can be null
        $asalSekolah = AsalSekolah::create([
            'nama_sekolah' => 'Test School',
            'npsn' => '12345678',
            'nsm' => null, // This should be allowed
            'alamat' => 'Test Address',
            'kecamatan' => 'Test Kecamatan',
            'kabupaten_kota' => 'Test Kabupaten',
            'provinsi' => 'Test Provinsi',
            'status_sekolah' => 'negeri',
            'jenjang' => 'SD',
            'aktif' => true,
        ]);

        $this->assertNull($asalSekolah->nsm);
        $this->assertEquals('Test School', $asalSekolah->nama_sekolah);
    }

    public function test_enum_field_validation()
    {
        // Test that enum fields only accept valid values
        $asalSekolah = new AsalSekolah();
        $asalSekolah->nama_sekolah = 'Test School';
        $asalSekolah->npsn = '12345678';
        $asalSekolah->alamat = 'Test Address';
        $asalSekolah->kecamatan = 'Test Kecamatan';
        $asalSekolah->kabupaten_kota = 'Test Kabupaten';
        $asalSekolah->provinsi = 'Test Provinsi';
        $asalSekolah->status_sekolah = 'negeri'; // Valid value
        $asalSekolah->jenjang = 'SD'; // Valid value
        $asalSekolah->aktif = true;
        
        $asalSekolah->save();
        
        $this->assertEquals('negeri', $asalSekolah->status_sekolah);
        $this->assertEquals('SD', $asalSekolah->jenjang);
    }

    public function test_boolean_field_casting()
    {
        $asalSekolah = AsalSekolah::create([
            'nama_sekolah' => 'Test School',
            'npsn' => '12345678',
            'alamat' => 'Test Address',
            'kecamatan' => 'Test Kecamatan',
            'kabupaten_kota' => 'Test Kabupaten',
            'provinsi' => 'Test Provinsi',
            'status_sekolah' => 'negeri',
            'jenjang' => 'SD',
            'aktif' => '1', // String representation
        ]);

        // Boolean casting should convert string to boolean
        $this->assertIsBool($asalSekolah->aktif);
        $this->assertTrue($asalSekolah->aktif);
    }

    public function test_model_relationship_integrity()
    {
        $user = User::factory()->create();
        $pendaftar = Pendaftar::factory()->create(['user_id' => $user->id]);

        // Test relationship integrity
        $this->assertEquals($user->id, $pendaftar->user->id);
        $this->assertInstanceOf(User::class, $pendaftar->user);
    }

    public function test_soft_delete_functionality()
    {
        $asalSekolah = AsalSekolah::create([
            'nama_sekolah' => 'Test School',
            'npsn' => '12345678',
            'alamat' => 'Test Address',
            'kecamatan' => 'Test Kecamatan',
            'kabupaten_kota' => 'Test Kabupaten',
            'provinsi' => 'Test Provinsi',
            'status_sekolah' => 'negeri',
            'jenjang' => 'SD',
            'aktif' => true,
        ]);

        $id = $asalSekolah->id;
        $asalSekolah->delete();

        // Should be soft deleted (still in database but with deleted_at)
        $this->assertNotNull($asalSekolah->deleted_at);

        // Should not appear in regular queries
        $found = AsalSekolah::find($id);
        $this->assertNull($found);

        // Should appear in withTrashed queries
        $foundWithTrashed = AsalSekolah::withTrashed()->find($id);
        $this->assertNotNull($foundWithTrashed);
    }

    public function test_timestamps_automatically_set()
    {
        $asalSekolah = AsalSekolah::create([
            'nama_sekolah' => 'Test School',
            'npsn' => '12345678',
            'alamat' => 'Test Address',
            'kecamatan' => 'Test Kecamatan',
            'kabupaten_kota' => 'Test Kabupaten',
            'provinsi' => 'Test Provinsi',
            'status_sekolah' => 'negeri',
            'jenjang' => 'SD',
            'aktif' => true,
        ]);

        $this->assertNotNull($asalSekolah->created_at);
        $this->assertNotNull($asalSekolah->updated_at);
        $this->assertInstanceOf(\Carbon\Carbon::class, $asalSekolah->created_at);
    }

    public function test_setting_model_get_set_functions()
    {
        // Test Setting model's get and set functions
        Setting::set('test_key', 'test_value', 'string', 'Test Description');
        
        $value = Setting::get('test_key');
        $this->assertEquals('test_value', $value);
        
        // Test default value
        $defaultValue = Setting::get('nonexistent_key', 'default_value');
        $this->assertEquals('default_value', $defaultValue);
    }

    public function test_faq_model_scopes()
    {
        // Create test FAQs
        Faq::create([
            'pertanyaan' => 'Test Question 1',
            'jawaban' => 'Test Answer 1',
            'urutan' => 1,
            'aktif' => true,
        ]);
        
        Faq::create([
            'pertanyaan' => 'Test Question 2',
            'jawaban' => 'Test Answer 2',
            'urutan' => 2,
            'aktif' => false,
        ]);

        // Test aktif scope
        $aktifFaqs = Faq::aktif()->get();
        $this->assertCount(1, $aktifFaqs);
        $this->assertTrue($aktifFaqs[0]->aktif);

        // Test ordered scope
        $orderedFaqs = Faq::ordered()->get();
        $this->assertEquals(1, $orderedFaqs[0]->urutan);
        $this->assertEquals(2, $orderedFaqs[1]->urutan);
    }

    public function test_data_consistency_across_models()
    {
        // Test that related models maintain consistency
        $user = User::factory()->create([
            'email' => 'test@example.com',
            'role' => 'pendaftar'
        ]);
        
        $pendaftar = Pendaftar::factory()->create([
            'user_id' => $user->id,
            'email' => 'test@example.com' // Should match user email
        ]);

        $this->assertEquals($user->email, $pendaftar->email);
        $this->assertEquals($user->id, $pendaftar->user_id);
    }
}