<?php

namespace Tests\Unit;

use Tests\TestCase;
use Illuminate\Foundation\Testing\RefreshDatabase;
use App\Models\User;
use App\Models\Pendaftar;
use Illuminate\Support\Facades\Hash;
use Illuminate\Http\UploadedFile;

class SecurityTest extends TestCase
{
    use RefreshDatabase;

    public function test_password_hashing_security()
    {
        $user = User::factory()->create([
            'password' => Hash::make('password123')
        ]);

        // Test that password is properly hashed
        $this->assertTrue(Hash::check('password123', $user->password));
        $this->assertFalse(Hash::check('wrongpassword', $user->password));
        
        // Test that password is not stored in plain text
        $this->assertNotEquals('password123', $user->password);
        $this->assertStringContainsString('$2y$', $user->password); // bcrypt hash prefix
    }

    public function test_xss_protection_in_models()
    {
        $user = User::factory()->create([
            'name' => '<script>alert("XSS")</script>John Doe',
            'email' => 'test@example.com'
        ]);

        // When retrieving data, it should be properly sanitized for display contexts
        $this->assertStringContainsString('<script>', $user->name); // Raw data contains it
        
        // But in display context, it should be escaped
        $escapedName = e($user->name); // Laravel's e() helper escapes HTML
        $this->assertStringNotContainsString('<script>', $escapedName);
        $this->assertStringContainsString('&lt;script&gt;', $escapedName);
    }

    public function test_sql_injection_prevention()
    {
        // Test that Eloquent properly escapes queries
        $maliciousInput = "'; DROP TABLE users; --";
        
        // This should not cause SQL injection
        $result = User::where('email', $maliciousInput)->get();
        
        // Should return empty collection, not crash the application
        $this->assertIsIterable($result);
    }

    public function test_csrf_token_validation()
    {
        $response = $this->post('/login', [
            'email' => 'test@example.com',
            'password' => 'password'
        ], [
            'X-CSRF-TOKEN' => ''
        ]);

        // Should return 419 (CSRF token mismatch) or 422 (validation error)
        $response->assertStatus(419); // CSRF token mismatch
    }

    public function test_authentication_middleware_protection()
    {
        // Test that admin routes are protected
        $response = $this->get('/admin/dashboard');
        $response->assertRedirect('/login/admin'); // Should redirect to login
        
        // Test that unauthorized users can't access admin routes
        $user = User::factory()->create(['role' => 'pendaftar']);
        $response = $this->actingAs($user)->get('/admin/dashboard');
        $response->assertForbidden(); // Should return 403
    }

    public function test_authorization_for_admin_routes()
    {
        // Test that only admin users can access admin routes
        $adminUser = User::factory()->create(['role' => 'admin']);
        $regularUser = User::factory()->create(['role' => 'pendaftar']);
        
        // Admin should have access
        $response = $this->actingAs($adminUser)->get('/admin/dashboard');
        $response->assertOk();
        
        // Regular user should not have access
        $response = $this->actingAs($regularUser)->get('/admin/dashboard');
        $response->assertForbidden();
    }

    public function test_sensitive_data_not_exposed_in_api()
    {
        $user = User::factory()->create([
            'password' => Hash::make('secret123'),
            'remember_token' => 'remember_token_value'
        ]);

        $response = $this->actingAs($user)->get('/api/user');
        
        // Password and remember token should not be exposed
        $responseData = $response->json();
        $this->assertArrayNotHasKey('password', $responseData);
        $this->assertArrayNotHasKey('remember_token', $responseData);
    }

    public function test_file_upload_security()
    {
        // Test that file uploads are properly validated
        $user = User::factory()->create(['role' => 'admin']);

        // Try to upload malicious file
        $file = \Illuminate\Http\UploadedFile::fake()->create('malicious.php', 100, 'application/php');

        $response = $this->actingAs($user)
            ->post('/admin/upload', ['file' => $file]);

        // Should reject the file
        $response->assertSessionHasErrors(); // Assuming validation fails
    }
}