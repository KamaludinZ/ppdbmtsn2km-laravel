<?php

namespace Tests\Feature;

use Tests\TestCase;
use Illuminate\Foundation\Testing\RefreshDatabase;
use App\Models\User;
use App\Models\Pendaftar;
use App\Models\JalurPendaftaran;

class PerformanceFeatureTest extends TestCase
{
    use RefreshDatabase;

    public function test_homepage_load_time()
    {
        $start = microtime(true);
        $response = $this->get('/');
        $end = microtime(true);
        
        $loadTime = $end - $start;
        
        // Homepage should load quickly
        $this->assertLessThan(2.0, $loadTime);
        $response->assertStatus(200);
    }

    public function test_admin_dashboard_load_time()
    {
        $admin = User::factory()->create(['role' => 'admin']);
        
        $start = microtime(true);
        $response = $this->actingAs($admin)->get('/admin/dashboard');
        $end = microtime(true);
        
        $loadTime = $end - $start;
        
        // Admin dashboard should load efficiently
        $this->assertLessThan(3.0, $loadTime);
        $response->assertStatus(200);
    }

    public function test_pendaftar_list_page_performance()
    {
        $admin = User::factory()->create(['role' => 'admin']);
        $jalur = JalurPendaftaran::factory()->create();
        
        // Create multiple pendaftar records
        Pendaftar::factory(100)->create([
            'jalur_pendaftaran_id' => $jalur->id
        ]);

        $start = microtime(true);
        $response = $this->actingAs($admin)->get('/admin/pendaftar');
        $end = microtime(true);
        
        $loadTime = $end - $start;
        
        // Pendaftar list should load efficiently even with 100 records
        $this->assertLessThan(3.0, $loadTime);
        $response->assertStatus(200);
    }

    public function test_search_performance()
    {
        $admin = User::factory()->create(['role' => 'admin']);
        $jalur = JalurPendaftaran::factory()->create();
        
        // Create dataset for search testing
        Pendaftar::factory(50)->create([
            'jalur_pendaftaran_id' => $jalur->id,
            'nama_lengkap' => 'John Doe Test',
        ]);

        $start = microtime(true);
        $response = $this->actingAs($admin)->get('/admin/pendaftar?search=John');
        $end = microtime(true);
        
        $searchTime = $end - $start;
        
        // Search should be efficient
        $this->assertLessThan(2.0, $searchTime);
        $response->assertStatus(200);
    }

    public function test_concurrent_user_sessions()
    {
        // Create multiple users
        $users = User::factory(5)->create();
        
        $start = microtime(true);
        
        // Simulate concurrent access
        foreach ($users as $user) {
            $this->actingAs($user)->get('/dashboard');
        }
        
        $concurrentTime = microtime(true) - $start;
        
        // Concurrent access should be handled efficiently
        $this->assertLessThan(5.0, $concurrentTime);
    }

    public function test_api_endpoint_response_time()
    {
        $admin = User::factory()->create(['role' => 'admin']);
        
        $start = microtime(true);
        $response = $this->actingAs($admin)->getJson('/api/admin/stats');
        $end = microtime(true);
        
        $apiTime = $end - $start;
        
        // API should respond quickly
        $this->assertLessThan(1.0, $apiTime);
        $response->assertStatus(200);
    }

    public function test_form_submission_performance()
    {
        $admin = User::factory()->create(['role' => 'admin']);
        
        $formData = [
            'nama_sekolah' => 'Test School Performance',
            'npsn' => '12345678',
            'nsm' => '123456789012',
            'alamat' => 'Test Address Performance',
            'kecamatan' => 'Test Kecamatan',
            'kabupaten_kota' => 'Test Kabupaten',
            'provinsi' => 'Test Provinsi',
            'status_sekolah' => 'negeri',
            'jenjang' => 'SD',
            'aktif' => true,
        ];

        $start = microtime(true);
        $response = $this->actingAs($admin)
            ->post('/admin/data-asal-sekolah', $formData);
        $end = microtime(true);
        
        $submissionTime = $end - $start;
        
        // Form submission should be efficient
        $this->assertLessThan(2.0, $submissionTime);
    }

    public function test_image_upload_performance()
    {
        $admin = User::factory()->create(['role' => 'admin']);
        
        $image = \Illuminate\Http\UploadedFile::fake()->image('test.jpg', 1024, 768);
        
        $start = microtime(true);
        $response = $this->actingAs($admin)
            ->post('/admin/upload', ['image' => $image]);
        $end = microtime(true);
        
        $uploadTime = $end - $start;
        
        // Image upload should be efficient
        $this->assertLessThan(5.0, $uploadTime);
    }

    public function test_database_connection_pooling()
    {
        $admin = User::factory()->create(['role' => 'admin']);
        
        // Perform multiple database operations
        $start = microtime(true);
        for ($i = 0; $i < 10; $i++) {
            $this->actingAs($admin)->get('/admin/pendaftar?page=' . ($i + 1));
        }
        $multiQueryTime = microtime(true) - $start;
        
        // Multiple queries should be handled efficiently
        $this->assertLessThan(10.0, $multiQueryTime);
    }

    public function test_cache_hit_vs_miss_performance()
    {
        // Test cache performance
        $start = microtime(true);
        for ($i = 0; $i < 100; $i++) {
            \Illuminate\Support\Facades\Cache::put("test_key_$i", "value_$i", 3600);
        }
        $cacheSetTime = microtime(true) - $start;

        $start = microtime(true);
        for ($i = 0; $i < 100; $i++) {
            $value = \Illuminate\Support\Facades\Cache::get("test_key_$i");
        }
        $cacheGetTime = microtime(true) - $start;

        // Cache operations should be fast
        $this->assertLessThan(5.0, $cacheSetTime);
        $this->assertLessThan(2.0, $cacheGetTime);
    }
}