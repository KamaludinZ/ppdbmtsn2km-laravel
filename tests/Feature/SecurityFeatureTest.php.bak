<?php

namespace Tests\Feature;

use Tests\TestCase;
use Illuminate\Foundation\Testing\RefreshDatabase;
use App\Models\User;
use Illuminate\Support\Facades\Hash;

class SecurityFeatureTest extends TestCase
{
    use RefreshDatabase;

    public function test_login_rate_limiting()
    {
        $user = User::factory()->create([
            'email' => 'test@example.com',
            'password' => Hash::make('password'),
        ]);

        // Try to login with wrong password multiple times
        for ($i = 0; $i < 6; $i++) {
            $response = $this->post('/login', [
                'email' => 'test@example.com',
                'password' => 'wrongpassword',
            ]);
        }

        // Should trigger rate limiting after multiple attempts
        $response->assertStatus(429); // Too Many Requests
    }

    public function test_brute_force_protection()
    {
        $user = User::factory()->create([
            'email' => 'test@example.com',
            'password' => Hash::make('password'),
        ]);

        // Simulate brute force attack
        for ($i = 0; $i < 10; $i++) {
            $this->post('/login', [
                'email' => 'test@example.com',
                'password' => 'incorrect' . $i,
            ]);
        }

        // Additional requests should be blocked
        $response = $this->post('/login', [
            'email' => 'test@example.com',
            'password' => 'password', // Correct password
        ]);

        // Even with correct password, should be blocked due to rate limiting
        $this->assertTrue(true); // Placeholder - actual rate limiting depends on implementation
    }

    public function test_session_security_headers()
    {
        $response = $this->get('/login');
        
        // Check for security headers
        $response->assertHeader('X-Content-Type-Options', 'nosniff');
        $response->assertHeader('X-Frame-Options', 'DENY'); // or SAMEORIGIN depending on config
        $response->assertHeader('X-XSS-Protection', '1; mode=block');
    }

    public function test_csrf_protection_on_forms()
    {
        $response = $this->get('/login');
        $response->assertSuccessful();
        
        // Try to submit form without CSRF token
        $response = $this->post('/login', [
            'email' => 'test@example.com',
            'password' => 'password',
        ], [
            'X-CSRF-TOKEN' => '',
        ]);

        $response->assertStatus(419); // CSRF token mismatch
    }

    public function test_sql_injection_attempts_blocked()
    {
        // Test SQL injection in search
        $response = $this->get('/admin/pendaftar?search=\'; DROP TABLE users; --');
        
        // Should not crash the application
        $response->assertStatus(200);
    }

    public function test_xss_attempts_blocked()
    {
        $user = User::factory()->create([
            'email' => '<script>alert("XSS")</script>test@example.com',
            'password' => Hash::make('password'),
        ]);

        $response = $this->post('/login', [
            'email' => '<script>alert("XSS")</script>test@example.com',
            'password' => 'password',
        ]);

        // Should not execute XSS
        $response->assertStatus(302); // Redirect after login attempt
    }

    public function test_file_upload_security_checks()
    {
        // Test file upload with dangerous extensions
        $user = User::factory()->create(['role' => 'admin']);
        
        $file = \Illuminate\Http\UploadedFile::fake()->create('dangerous.php', 100, 'application/x-php');
        
        $response = $this->actingAs($user)
            ->post('/admin/upload', ['file' => $file]);
        
        // Should reject dangerous file types
        $response->assertSessionHasErrors();
    }

    public function test_admin_route_protection()
    {
        // Test that admin routes require authentication
        $response = $this->get('/admin/dashboard');
        $response->assertRedirect('/login/admin');
        
        // Test that non-admin users can't access admin routes
        $user = User::factory()->create(['role' => 'pendaftar']);
        $response = $this->actingAs($user)->get('/admin/dashboard');
        $response->assertForbidden();
    }

    public function test_sensitive_data_not_exposed()
    {
        $user = User::factory()->create([
            'email' => 'admin@example.com',
            'role' => 'admin',
            'password' => Hash::make('password'),
        ]);

        $response = $this->actingAs($user)
            ->getJson('/api/users')
            ->assertSuccessful();

        // Check that sensitive data is not exposed
        $response->assertJsonMissing(['password']);
        $response->assertJsonMissing(['remember_token']);
    }

    public function test_authorization_for_different_roles()
    {
        // Test admin access
        $admin = User::factory()->create(['role' => 'admin']);
        $response = $this->actingAs($admin)->get('/admin/dashboard');
        $response->assertOk();

        // Test pendaftar access to admin route
        $pendaftar = User::factory()->create(['role' => 'pendaftar']);
        $response = $this->actingAs($pendaftar)->get('/admin/dashboard');
        $response->assertForbidden();

        // Test panitia access to admin route
        $panitia = User::factory()->create(['role' => 'panitia_pendaftaran']);
        $response = $this->actingAs($panitia)->get('/admin/dashboard');
        $response->assertForbidden();
    }
}