# .htaccess untuk ROOT folder (bukan public)
# Upload file ini ke root subdomain dan rename jadi .htaccess

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect semua request ke folder public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Deny access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(json|lock|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>